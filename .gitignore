# Python virtual environments
.venv/
venv/
ENV/
env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# Model weights & binaries (auto-downloaded at runtime by ultralytics/hailort)
*.pt
*.onnx
*.hef
*.engine

# Benchmark video files (downloaded via scripts/download_benchmarks.py)
data/benchmarks/*.mp4

# Generated outputs
output/*.png
output/*.json
!output/.gitkeep

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.log
